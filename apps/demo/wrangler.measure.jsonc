// A throwaway deployment of the demo for measuring refusal timing and CPU time;
// see docs/refusal-floor.md and docs/workers-free.md. It has its own Durable
// Objects, no floor, and rate limits too high to refuse. Deploy it with RP_ID
// and ORIGIN set to its workers.dev host, measure, then delete it.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "passkey-canvas-measure",
  "main": "src/measure.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "vars": {
    "RP_NAME": "Refusal timing measurement",
    "REFUSAL_FLOOR_MS": "0"
  },
  "durable_objects": {
    "bindings": [
      { "name": "IDENTITY_RECORDS", "class_name": "IdentityRecord" },
      { "name": "CREDENTIAL_INDEX", "class_name": "CredentialIndex" },
      { "name": "CHALLENGES", "class_name": "ChallengeStore" },
      { "name": "MEMBER_NAMES", "class_name": "MemberNameRegistry" },
      { "name": "CREDENTIAL_LABELS", "class_name": "CredentialLabels" },
      { "name": "RATE_LIMITS", "class_name": "RateLimiter" },
      { "name": "CEREMONY_FAILURES", "class_name": "CeremonyFailures" },
      { "name": "OPERATOR_LOG", "class_name": "OperatorLog" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "IdentityRecord",
        "CredentialIndex",
        "ChallengeStore",
        "MemberNameRegistry",
        "CredentialLabels",
        "RateLimiter",
        "CeremonyFailures",
        "OperatorLog"
      ]
    }
  ],
  "observability": { "enabled": true }
}
